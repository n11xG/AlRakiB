<!DOCTYPE html>
<html lang="ar" dir="rtl">
<head>
<meta charset="UTF-8">
<meta name="viewport" content="width=device-width, initial-scale=1.0">
<title>الأكاديمية الملكية</title>
<link href="https://fonts.googleapis.com/css2?family=Amiri:wght@400;700&family=Cairo:wght@400;700;900&family=Tajawal:wght@400;500;700&display=swap" rel="stylesheet">
<style>
    :root {
        /* الوضع الليلي (الافتراضي) */
        --bg-body: radial-gradient(circle at center, #150a25 0%, #0a0510 100%);
        --bg-panel: rgba(15, 10, 24, 0.95);
        --text-main: #e6d5b8;
        --text-muted: #a899c4;
        --gold: #d4af37;
        --gold-glow: rgba(212, 175, 55, 0.4);
        --purple: #6a0dad;
        --border-color: rgba(212, 175, 55, 0.2);
        --toolbar-bg: rgba(25, 15, 40, 0.8);
        --toolbar-border: rgba(212, 175, 55, 0.3);
    }

    /* الوضع النهاري */
    body.light-mode {
        --bg-body: radial-gradient(circle at center, #f4f1ea 0%, #e2dcd0 100%);
        --bg-panel: rgba(255, 255, 255, 0.95);
        --text-main: #2c241b;
        --text-muted: #5a4b3c;
        --gold: #8b5a2b;
        --gold-glow: rgba(139, 90, 43, 0.2);
        --purple: #4a2c7a;
        --border-color: rgba(139, 90, 43, 0.2);
        --toolbar-bg: rgba(255, 255, 255, 0.9);
        --toolbar-border: rgba(139, 90, 43, 0.3);
    }

    * {
        margin: 0;
        padding: 0;
        box-sizing: border-box;
        transition: background-color 0.4s ease, color 0.4s ease, border-color 0.4s ease;
    }

    body {
        font-family: 'Amiri', serif;
        background: var(--bg-body);
        min-height: 100vh;
        color: var(--text-main);
        display: flex;
        flex-direction: column;
        align-items: center;
        padding: 40px 20px;
        overflow-x: hidden;
    }

    /* تأثير الجزيئات السحرية (تم إصلاحه ليكون ناعماً) */
    .magic-particles {
        position: fixed;
        top: 0; left: 0; width: 100%; height: 100%;
        pointer-events: none;
        z-index: 0;
        overflow: hidden;
    }

    .particle {
        position: absolute;
        background: var(--gold);
        border-radius: 50%;
        box-shadow: 0 0 10px var(--gold);
        animation: floatUp linear infinite;
        opacity: 0;
        will-change: transform, opacity; /* لتحسين أداء الأنميشن */
    }

    @keyframes floatUp {
        0% { transform: translateY(110vh) translateX(0) scale(0.5); opacity: 0; }
        10% { opacity: 0.6; }
        90% { opacity: 0.6; }
        100% { transform: translateY(-10vh) translateX(50px) scale(1); opacity: 0; }
    }

    /* شريط الأدوات (تكبير/تصغير الخط، الوضع الليلي) */
    .reader-toolbar {
        position: sticky;
        top: 20px;
        z-index: 100;
        display: flex;
        gap: 15px;
        background: var(--toolbar-bg);
        backdrop-filter: blur(10px);
        -webkit-backdrop-filter: blur(10px);
        padding: 10px 20px;
        border-radius: 50px;
        border: 1px solid var(--toolbar-border);
        box-shadow: 0 10px 30px rgba(0,0,0,0.3);
        margin-bottom: 30px;
    }

    .tool-btn {
        background: transparent;
        border: none;
        color: var(--gold);
        font-family: 'Cairo', sans-serif;
        font-weight: 700;
        font-size: 1.1rem;
        cursor: pointer;
        width: 40px;
        height: 40px;
        display: flex;
        justify-content: center;
        align-items: center;
        border-radius: 50%;
        transition: all 0.3s ease;
    }

    .tool-btn:hover {
        background: var(--gold-glow);
        transform: scale(1.1);
    }

    .tool-divider {
        width: 1px;
        background: var(--border-color);
        margin: 5px 0;
    }

    /* الحاوية الرئيسية */
    .chapter-container {
        position: relative;
        z-index: 10;
        max-width: 850px;
        width: 100%;
        background: var(--bg-panel);
        backdrop-filter: blur(15px);
        -webkit-backdrop-filter: blur(15px);
        border-radius: 4px;
        border: 1px solid var(--border-color);
        box-shadow: 0 30px 60px rgba(0, 0, 0, 0.6), inset 0 0 60px rgba(106, 13, 173, 0.05);
        padding: 60px 70px;
    }

    /* ترويسة الفصل */
    .chapter-header {
        text-align: center;
        margin-bottom: 45px;
        position: relative;
        padding-bottom: 30px;
    }

    .chapter-title {
        font-family: 'Cairo', sans-serif;
        font-size: 3rem;
        font-weight: 900;
        color: var(--gold);
        text-shadow: 0 4px 10px rgba(0,0,0,0.4);
        letter-spacing: 2px;
    }

    .header-line {
        width: 150px;
        height: 2px;
        background: linear-gradient(90deg, transparent, var(--gold), transparent);
        margin: 20px auto 0;
        box-shadow: 0 0 10px var(--gold-glow);
    }

    /* محتوى النص (متغير الحجم) */
    .story-content {
        font-size: 1.4rem; /* الحجم الافتراضي */
        line-height: 2.3;
        text-align: justify;
        color: var(--text-main);
        transition: font-size 0.3s ease;
    }

    .story-content p {
        margin-bottom: 25px;
        text-shadow: 1px 1px 3px rgba(0,0,0,0.1);
    }

    /* فاصل نصي أنيق */
    .text-divider {
        text-align: center;
        margin: 35px 0;
        color: var(--gold);
        font-size: 1.2rem;
        letter-spacing: 5px;
        opacity: 0.7;
    }

    .highlight {
        color: var(--text-main);
        font-weight: 700;
        text-shadow: 0 0 15px var(--purple);
    }

    em {
        color: var(--text-muted);
        font-style: italic;
        font-size: 1.1em;
    }

    /* زر العودة للأعلى */
    .back-to-top {
        position: fixed;
        bottom: 30px;
        left: 30px;
        width: 45px;
        height: 45px;
        background: var(--bg-panel);
        border: 1px solid var(--gold);
        color: var(--gold);
        border-radius: 50%;
        cursor: pointer;
        display: flex;
        justify-content: center;
        align-items: center;
        font-size: 1.2rem;
        opacity: 0;
        pointer-events: none;
        transition: all 0.3s ease;
        z-index: 100;
    }

    .back-to-top.show {
        opacity: 1;
        pointer-events: auto;
    }

    .back-to-top:hover {
        background: var(--gold);
        color: var(--bg-body);
        transform: translateY(-5px);
    }

    /* للجوال */
    @media (max-width: 768px) {
        .chapter-container { padding: 40px 25px; }
        .chapter-title { font-size: 2.2rem; }
        .story-content { font-size: 1.2rem; }
        .reader-toolbar { padding: 8px 15px; }
    }
</style>
</head>
<body>

    <!-- شريط الأدوات -->
    <div class="reader-toolbar">
        <button class="tool-btn" onclick="changeFontSize(1)" title="تكبير الخط">A+</button>
        <button class="tool-btn" onclick="changeFontSize(-1)" title="تصغير الخط">A-</button>
        <div class="tool-divider"></div>
        <button class="tool-btn" onclick="toggleTheme()" title="تغيير المظهر" id="themeBtn">☀</button>
    </div>

    <!-- الجزيئات السحرية -->
    <div class="magic-particles" id="particles"></div>

    <!-- حاوية الفصل -->
    <div class="chapter-container">
        
        <div class="chapter-header">
            <h1 class="chapter-title">الأكاديمية الملكية</h1>
            <div class="header-line"></div>
        </div>

        <!-- المحتوى مع ID لتغيير حجم الخط -->
        <div class="story-content" id="storyText">
            <p>عالم تتوحّد فيه الممالك، وتختلف فيه الحضارات، وتتباين فيه حياة الناس بين المدن المزدهرة والقرى البسيطة.</p>
            
            <p>تألفت قارات تجمع شعوبًا وثقافات مختلفة: الأقزام، والجان، والعمالقة، وكل مكان يحمل حكايات لا يُروى منها سوى القليل.</p>

            <div class="text-divider">* * *</div>

            <p>في هذا العالم، يشكل السحر جزءًا من الحياة اليومية، يدرس ويتعلم، ويختلف قدرات الناس في إتقانه. ويعتمد بعض السلالات بالثقافة والمكانة، ويكتسب آخرون قوة لأنفسهم مكانًا بين أصحاب السلطة والإمارات.</p>

            <p>هنا، لا تحدد الأصول وحدها ما يمكن للإنسان أن يصنع عليه، ولا تسير جميع الطرق وفق ما خُطط لها. <span class="highlight">ومن بين كل تلك الحكايات، تبدأ حكاية واحدة...</span></p>

            <div class="text-divider">* * *</div>

            <p>في مكان ما من قارة أركان، كانت الأيام تمر بهدوء، والنفوس مشتاقة بحلمها المشاع، دون أن يدركوا أن بعض البدايات لا تحتاج إلى صدفة، بل إلى تخطيط كل شيء.</p>

            <p>في العاصمة الملكية، كانت الاستعدادات جارية لاستقبال عالم دراسي جديد في الأكاديمية الملكية.</p>

            <p>طلاب من عائلات نبيلة، وأبناء شخصيات ذات نفوذ، وآخرون قادمون من مناطق بعيدة. جميعهم سيجتمعون تحت سقف واحد، وأغلبهم من عائلات غامضة.</p>

            <p>لم يكن أحد يعرف ما الذي سيحدثه هذا العالم.</p>

            <div class="text-divider">* * *</div>

            <p>في قرية بعيدة عن صخب العاصمة، كان هناك شخص يعيش حياة عادية. لا يختلف يومه كثيرًا عن اليوم الذي سبقه.</p>

            <p>لم يكن هناك سوى طفلًا متواضع، وأبوين بسيطين، وأسرارًا متواضعة في أماكن لم يتوقعها أحد.</p>

            <p>لم يكن يدري أن خطوة واحدة قد تكون كافية لتغيير كل ما اعتاد عليه.</p>

            <p>أما ما تحمله الأيام القادمة، فليس كل ما يمر سيبدو صنيقي. <span class="highlight">فليس كل من يحمل في الظل سيعطى إلى الأبد.</span></p>

            <p style="text-align:center; color:var(--gold); font-style:italic; margin-top:40px;">ومن بين كل تلك الحكايات، تبدأ حكاية واحدة...</p>
        </div>

    </div>

    <!-- زر العودة للأعلى -->
    <button class="back-to-top" id="backToTop" onclick="window.scrollTo({top: 0, behavior: 'smooth'})">↑</button>

    <script>
        // --- 1. إعداد الجزيئات السحرية (أداء أفضل) ---
        function createParticles() {
            const container = document.getElementById('particles');
            const particleCount = 20; // عدد مثالي لا يستهلك موارد الجهاز

            for (let i = 0; i < particleCount; i++) {
                const p = document.createElement('div');
                p.className = 'particle';
                
                const size = Math.random() * 4 + 2;
                p.style.width = `${size}px`;
                p.style.height = `${size}px`;
                p.style.left = `${Math.random() * 100}%`;
                
                // حركة بطيئة جداً وناعمة
                p.style.animationDuration = `${Math.random() * 15 + 15}s`;
                p.style.animationDelay = `${Math.random() * 10}s`;
                
                container.appendChild(p);
            }
        }

        // --- 2. التحكم في حجم الخط ---
        let currentFontSize = 1.4; // الحجم الافتراضي بالـ rem
        const storyText = document.getElementById('storyText');

        function changeFontSize(step) {
            currentFontSize += (step * 0.1);
            
            // الحد الأدنى والأقصى
            if (currentFontSize < 1.0) currentFontSize = 1.0;
            if (currentFontSize > 2.5) currentFontSize = 2.5;

            storyText.style.fontSize = `${currentFontSize}rem`;
        }

        // --- 3. التحكم في الوضع الليلي/النهاري ---
        function toggleTheme() {
            document.body.classList.toggle('light-mode');
            const themeBtn = document.getElementById('themeBtn');
            
            if (document.body.classList.contains('light-mode')) {
                themeBtn.innerHTML = '🌙'; // يتحول للوضع الليلي
            } else {
                themeBtn.innerHTML = '☀'; // يتحول للوضع النهاري
            }
        }

        // --- 4. زر العودة للأعلى ---
        window.addEventListener('scroll', () => {
            const btn = document.getElementById('backToTop');
            if (window.scrollY > 300) {
                btn.classList.add('show');
            } else {
                btn.classList.remove('show');
            }
        });

        // التشغيل
        window.onload = createParticles;
    </script>
</body>
</html>
